rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /hotels/{hotelId}/{fileName} {
      allow read: if true;
      // Production recommendation: replace this with a Firebase Auth custom-claim admin check.
      // For the included starter, authenticated users can upload only into hotel paths.
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}